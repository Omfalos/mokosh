// mokosh's own first-party Kotlin grammar (see docs/adr-021-kotlin-parsing.md for why this
// exists as an authored grammar rather than a dependency). Informed by — not copied from —
// JetBrains' published Kotlin grammar spec (kotlin-spec, Apache-2.0), the reference every
// Kotlin tool works from.
//
// Scope is deliberately incremental (docs/adr-021-kotlin-parsing.md lists what's covered and
// what's deferred): enough to find declaration/function boundaries and call-expression shapes
// for complexity + call-edge extraction (mokosh's actual need), not full Kotlin syntax. Gaps are
// grown test-first as real .kt files surface them (see src/parser/lang/kotlin/README.md).

@precedence {
  postfix @left
  prefix
  asCast @left
  times @left
  plus @left
  range @left
  infixFn @left
  elvis @right
  namedCheck @left
  compare @left
  equality @left
  and @left
  or @left
  assign @right
  else @right
  scope @left
  typeArgs
  // Not real Kotlin operator precedence — a name for the recurring "optional trailing piece of
  // this rule vs. start of the next sibling in the enclosing repetition" shift/reduce conflict
  // (e.g. `break` immediately followed by `@Foo` — is `@Foo` this break's label, or the next
  // statement's annotation?). Always resolved by preferring to shift into the current rule's own
  // optional suffix. See docs/adr-021-kotlin-parsing.md.
  greedy
  // Below `greedy`: marks the *reduce* side of `@Foo<T>` followed by `(`, so the shift into the
  // annotation's own ArgumentList wins over a primary constructor's parenthesis.
  annotationEnd
}

// File-level annotations (`@file:OptIn(Foo::class)`) precede `package` in real Kotlin — before
// this, `annotationUse` was only reachable via a declaration's `modifier*`, never at `Program`
// level, so a leading `@file:...` failed to parse at all (not just its arguments) and its error
// recovery cascaded through everything until the next resync point, corrupting the whole file.
// `annotationUse*` here (not narrowed to just the `file` target) matches this grammar's existing
// superset-acceptance convention elsewhere (e.g. ImportHeader's stray wildcard, ClassBody's
// ungated enum-entry list) rather than tracking the semantic file-vs-declaration distinction.
@top Program {
  Shebang? (!greedy annotationUse)* PackageHeader? ImportHeader* topLevelDeclaration*
}

// `.kts` scripts (Gradle build files) are a sequence of top-level *statements* — `plugins { ... }`,
// `if (...) { ... }`, `println("hi")` — not declarations, so they get their own top rule
// (selected with `parser.configure({ top: "Script" })`, see `index.ts`) rather than widening
// `Program`, whose `topLevelDeclaration*` repetition can't also take statements without
// reduce/reduce conflicts. The body reuses the exact `Nl`-separated statement shape of a `Block`,
// so every statement construct (calls, lambdas, `if`, `val`/`fun` locals, …) parses identically to
// a function body. Unlike `Program`, the tokenizer may emit `Nl` after a file annotation, the
// package header and each import (it can't know a statement list is not yet open), so those
// positions accept an optional `Nl`. Top-level `class`/`object` in a script is unsupported (same local-class gap as
// function bodies — see the comment above `statement`).
@top Script {
  Shebang? Nl? (!greedy annotationUse Nl?)* (PackageHeader Nl?)? (ImportHeader Nl?)*
  (statement (Nl statement)* Nl?)?
}

PackageHeader {
  kw<"package"> dottedName
}

// Written as one flat repetition (not `dottedName ("." Asterisk)?`) so the wildcard segment
// doesn't create a dangling-optional shift/reduce conflict against dottedName's own trailing
// `("." Identifier)*` — see docs/adr-021-kotlin-parsing.md. A stray `*` mid-path (not last) is
// accepted rather than rejected; that's a superset of real Kotlin syntax, not a correctness gap.
ImportHeader {
  kw<"import"> Identifier ("." (Identifier | Asterisk))* (kw<"as"> Identifier)?
}

dottedName {
  Identifier ("." Identifier)*
}

topLevelDeclaration {
  ClassDeclaration |
  ObjectDeclaration |
  FunctionDeclaration |
  PropertyDeclaration |
  TypeAlias
}

modifier {
  ckw<"public"> | ckw<"private"> | ckw<"protected"> | ckw<"internal"> | ckw<"expect"> |
  ckw<"actual"> | ckw<"final"> | ckw<"open"> | ckw<"abstract"> | ckw<"sealed"> | ckw<"const"> |
  ckw<"external"> | ckw<"override"> | ckw<"lateinit"> | ckw<"tailrec"> | ckw<"vararg"> |
  ckw<"suspend"> | ckw<"inner"> | ckw<"enum"> | ckw<"annotation"> | ckw<"inline"> |
  ckw<"value"> | ckw<"infix"> | ckw<"operator"> | ckw<"data"> | ckw<"noinline"> |
  ckw<"crossinline"> | ckw<"reified"> | kw<"in"> | annotationUse | ContextReceivers
}

// `context(Foo, Bar) fun f()`.
ContextReceivers {
  ckw<"context"> "(" commaSep1<type> ")"
}

// Reuses the existing ArgumentList/callArgument machinery (already used by ConstructorInvocation/
// EnumEntry/CallExpression) for `@Foo(bar = 1)`-style arguments, gated by the same `!greedy`
// pattern this grammar uses at every other "optional trailing piece vs. next sibling" ambiguity.
// An earlier version of this rule deliberately omitted argument support, on the theory that
// pulling `expression` into the modifier soup that prefixes nearly every declaration would
// explode the LR automaton (see docs/adr-021-kotlin-parsing.md) — that theory didn't hold once
// `!greedy` was actually tried here: this builds clean. See PROGRESS.md's "Annotation-argument and
// use-site-target support" section (dogfooding against square/okhttp found this was the dominant
// cause of 25/339 real files silently skipping complexity/call-edge extraction).
annotationUse {
  "@" (useSiteTarget ":")? dottedName (AnnotationTypeArguments !annotationEnd (!greedy ArgumentList)? | !greedy ArgumentList)?
}

// The full real Kotlin use-site-target list (kotlinlang.org's "Use-site targets" reference), not
// just `file`: `get`/`set` reuse the same `ckw<>` terminals `PropertyAccessor` already declares
// (`ckw<>` tokens dedupe by name across the grammar, so this adds no new terminals, just new
// reachable paths to the existing ones).
useSiteTarget {
  ckw<"file"> | ckw<"property"> | ckw<"field"> | ckw<"get"> | ckw<"set"> |
  ckw<"receiver"> | ckw<"param"> | ckw<"setparam"> | ckw<"delegate">
}

ClassDeclaration {
  modifier* (kw<"class"> | kw<"interface"> | kw<"fun"> kw<"interface">) Definition TypeParameters? classTail (!greedy ClassBody)?
}

// Groups PrimaryConstructor?/DelegationSpecifiers?/TypeConstraints? into one lowercase (inlined,
// no extra tree node — same shape as before this split) sub-rule so their combinatorial product
// is enumerated once here instead of multiplying against ClassDeclaration's own TypeParameters?
// and ClassBody? every time the table is built — purely a choice-count reduction for
// @lezer/generator's "generating a lot of choices" warning, no grammatical change (this rule can
// already match empty, so it needs no trailing `?` of its own at the ClassDeclaration call site).
classTail {
  (!greedy PrimaryConstructor)? (":" DelegationSpecifiers)? (!greedy TypeConstraints)?
}

// Leading `modifier*` here (`class Foo private constructor(...)`) — an earlier version of this
// rule omitted it on the theory that a modifier directly after a class header was genuinely
// ambiguous against the *next* declaration's own modifier soup (docs/adr-021-kotlin-parsing.md).
// That theory wasn't tested empirically: adding it back built clean on the first attempt, with no
// `!greedy` needed even on the new `modifier*` itself. Omitting it wasn't just "the modifier
// doesn't attach" as previously documented — it silently collapsed the entire rest of the class
// into one bogus top-level FunctionDeclaration whose Block swallowed every subsequent member as
// unreachable LocalFunctionDeclaration statements (no error nodes, so ERROR_RATIO_THRESHOLD never
// caught it). See PROGRESS.md's "private constructor(...) mis-scoping" section — dogfooding
// against square/okhttp found 39 real files use this exact pattern.
PrimaryConstructor {
  modifier* (!greedy ckw<"constructor">)? "(" commaSep<ClassParameter> ")"
}

ClassParameter {
  modifier* (kw<"val"> | kw<"var">)? Definition ":" type ("=" expression)?
}

// Inlined (not via commaSep1<>) with an explicit `!greedy` on the comma: when a
// DelegationSpecifiers list sits inside an outer call's argument list (an ObjectLiteral used as
// a call argument, e.g. `foo(object : Base(), Other)`), "," is ambiguous between continuing this
// list and separating the next call argument — always prefer continuing it.
DelegationSpecifiers {
  DelegationSpecifier (!greedy "," DelegationSpecifier)*
}

DelegationSpecifier {
  ConstructorInvocation |
  ExplicitDelegation |
  type
}

ConstructorInvocation {
  type !greedy ArgumentList
}

ExplicitDelegation {
  type ckw<"by"> expression
}

TypeConstraints {
  ckw<"where"> TypeConstraint (!greedy "," TypeConstraint)*
}

TypeConstraint {
  Definition ":" type
}

// The optional leading enum-entry list (`RED, GREEN, BLUE` or `RED("#F00"), GREEN("#0F0")`,
// optionally followed by `;` then regular members) is accepted here unconditionally, not gated
// on the class actually having the `enum` modifier — a superset of real Kotlin syntax, same
// tradeoff already made elsewhere in this grammar (e.g. ImportHeader's stray wildcard). Gating it
// on `enum` would need a semantic (not just syntactic) condition this grammar doesn't track.
// No explicit `";"` between the entry list and `classMemberDeclaration*`: `;` is a globally
// skipped token (this grammar has no ASI, `;` is pure whitespace — see the `@skip` block below),
// so it can never appear as a literal in a rule; it's already invisible right where it'd go.
ClassBody {
  "{" (EnumEntry (!greedy "," EnumEntry)*)? classMemberDeclaration* "}"
}

EnumEntry {
  EnumEntryAnnotation* Definition (!greedy ArgumentList)? (!greedy ClassBody)?
}

// `@SerializedName("x") FOO` — `EntryAt` (tokens.js) is only emitted when what follows the annotation
// is an entry name, which keeps it from being confused with a member's leading annotation.
EnumEntryAnnotation {
  EntryAt (useSiteTarget ":")? dottedName (!greedy ArgumentList)?
}

classMemberDeclaration {
  CompanionObject |
  ObjectDeclaration |
  ClassDeclaration |
  FunctionDeclaration |
  PropertyDeclaration |
  TypeAlias |
  SecondaryConstructor |
  InitBlock
}

CompanionObject {
  modifier* ckw<"companion"> kw<"object"> Definition?
    (":" DelegationSpecifiers)? (!greedy ClassBody)?
}

ObjectDeclaration {
  modifier* kw<"object"> Definition (":" DelegationSpecifiers)? (!greedy ClassBody)?
}

SecondaryConstructor {
  modifier* ckw<"constructor"> "(" commaSep<ClassParameter> ")" ConstructorDelegationCall? Block?
}

ConstructorDelegationCall {
  ":" (kw<"this"> | kw<"super">) ArgumentList
}

InitBlock {
  ckw<"init"> Block
}

// Extension functions (`fun String.shout()`, `fun <T> List<T>.first()`, `fun a.b.Foo?.f()`): the
// receiver is a flat `(ReceiverSegment ("." | SafeNav))*` prefix before `Definition`, NOT a
// `receiverType "."` wrapper. A wrapper built from `simpleType` silently mis-parses — its
// ScopedTypeName alternative swallows `Foo.bar` whole, leaving nothing for `Definition`, with no
// build-time error. Flat segments let the parser decide on the token after each identifier: `.`
// or `?.` means another receiver segment, `(` (or, for properties, `:`/`=`/`by`/an accessor)
// means that identifier was the name. `SafeNav` is a separator because `Foo?.f` tokenizes as
// `Foo` `?.` `f`, never as `?` then `.`. There is deliberately no wrapping node: the receiver is
// several `ReceiverSegment` siblings, so the declaration's only direct-child `Definition` (what
// `getChild("Definition")` reads) is still its own name. A receiver that is itself a function type
// (`fun (suspend () -> T).f()`) is a `ParenReceiver`, tried before the segments.
FunctionDeclaration {
  modifier* kw<"fun"> TypeParameters? (ParenReceiver ".")? (ReceiverSegment ("." | SafeNav))* Definition
    "(" commaSep<FunctionParameter> ")" (":" type)? (!greedy TypeConstraints)? (!greedy functionBody)?
}

functionBody {
  Block | !greedy "=" expression
}

FunctionParameter {
  modifier* Definition ":" type ("=" expression)?
}

// Extension properties (`val String.foo get() = ...`, `val <T> List<T>.last: T`) use the same flat
// receiver prefix as FunctionDeclaration above. The receiver segments are their own nodes
// (`ReceiverSegment`, not `Identifier`), which is what avoids the Identifier-vs-Definition
// reduce/reduce this rule used to hit at the leading identifier.
PropertyDeclaration {
  modifier* (kw<"val"> | kw<"var">) TypeParameters? (ParenReceiver ".")? (ReceiverSegment ("." | SafeNav))* Definition
    propertyTail
    (!greedy "=" expression | !greedy ckw<"by"> expression)?
    (AccessorNl? !greedy PropertyAccessor | AccessorNl ModifiedAccessor)*
}

// Groups the type-annotation and TypeConstraints slots into one lowercase (inlined, no extra tree
// node) sub-rule — same choice-count-reduction rationale as ClassDeclaration's `classTail` above:
// bounds their combinatorial product to this rule instead of multiplying against
// PropertyDeclaration's TypeParameters?, initializer alternation, and PropertyAccessor* every time
// the table is built. No grammatical change (matches empty already, so no trailing `?` needed).
propertyTail {
  (":" type)? (!greedy TypeConstraints)?
}

// No leading `modifier*` (unlike most declarations): PropertyAccessor is an optional trailing
// piece of PropertyDeclaration, so a modifier here (`private set`) is ambiguous against the
// *next* top-level/member declaration's own modifier soup, same class of conflict as
// PrimaryConstructor above. `private set` still parses — the modifier just doesn't attach.
// The trailing `"(" ... ")" functionBody?` is *not* optional here (unlike an earlier version):
// a bare `get`/`set` with no parens at all isn't valid Kotlin syntax anyway (the only bare-keyword
// form Kotlin allows, `private set`, needs the leading modifier this grammar already doesn't
// support — see PropertyAccessor's own note below), and making it optional made "just `get`"
// simultaneously a complete PropertyAccessor and a continuable one, hitting the same unfixable
// `statement+ -> statement+ statement+` wall as ClassDeclaration/FunctionDeclaration in statement
// position (see declarationStatement's note above) — no precedence marker reaches it. Requiring
// the parens removes the ambiguous production instead of fighting it.
PropertyAccessor {
  !greedy ckw<"get"> !greedy "(" ")" (":" type)? functionBody? |
  !greedy ckw<"set"> !greedy "(" SetterParameter ")" functionBody?
}

// `private set` / `protected get()` — an accessor with visibility modifiers. Only reachable after
// `AccessorNl` (the tokenizer emits it before a modified accessor), which is what keeps these
// modifiers from being ambiguous against the next member's own modifier list.
ModifiedAccessor {
  modifier+ (ckw<"get"> | ckw<"set">) ("(" SetterParameter? ")" (":" type)? functionBody?)?
}

// A setter parameter's type is optional (`set(value) { ... }`), unlike a function parameter.
SetterParameter {
  modifier* Definition (":" type)?
}

TypeAlias {
  modifier* kw<"typealias"> Definition TypeParameters? "=" type
}

TypeParameters {
  "<" commaSep1<TypeParameter> ">"
}

TypeParameter {
  modifier* ckw<"out">? Definition (":" type)?
}

// Type-argument projection: `List<*>`, `Comparable<in T>`, `Producer<out T>`.
typeArg {
  "*" | (kw<"in"> | ckw<"out">)? type
}

// No standalone Block or IfStatement alternative here: Kotlin has no bare `{ ... }` block
// statement (a free-standing `{...}` is always a lambda literal, reached via ExpressionStatement)
// and no separate if-statement node (`if` is always IfExpression, used in statement position via
// ExpressionStatement too) — having both produced a reduce/reduce conflict against the
// expression-side node for the exact same input. See docs/adr-021-kotlin-parsing.md.
statement[@isGroup=Statement] {
  declarationStatement |
  AssignmentStatement |
  ExpressionStatement |
  ForStatement |
  WhileStatement |
  DoWhileStatement |
  LabeledStatement |
  jumpStatement
}

// `outer@ for (...) { ... }` — a label on a loop.
LabeledStatement {
  LabelDef (ForStatement | WhileStatement | DoWhileStatement)
}

// Also reachable as the right operand of `?:` (`x ?: return null`, `?: throw ...`, `?: continue`) —
// in real Kotlin these are expressions, here they stay statements everywhere else to avoid a
// dual representation (see `IfStatement`/`IfExpression` above), so `?:` names them directly.
jumpStatement {
  ReturnStatement |
  BreakStatement |
  ContinueStatement |
  ThrowStatement
}

// Kotlin assignment is a statement, not an expression (unlike Java/C) — `val x = (y = 1)` isn't
// valid Kotlin. Modeled at the statement level only so `expression` doesn't need to disambiguate
// `name = value` (assignment) from `name = value` (a named call argument) at the same position.
AssignmentStatement {
  expression !assign (AssignOp | "=") expression
}

// No ClassDeclaration here: a *locally-declared* class (nested in a function body) hits the
// same "attach vs. start next sibling" ambiguity as PrimaryConstructor/ClassBody above, but
// `!greedy` on ClassDeclaration's own `(!greedy ClassBody)?` can't reach it — the competing
// reduction comes from the generator's own internal `statement+ -> statement+ statement+`
// grouping (its binary splitting of `statement*` for incremental reparsing), not from a sibling
// rule this grammar controls, so there's no precedence hook to mark. Local classes are
// accordingly unsupported for now (top-level and class-member positions are unaffected — they
// reach ClassDeclaration via `topLevelDeclaration`/`classMemberDeclaration` instead). Phase 0b if
// this matters — see docs/adr-021-kotlin-parsing.md.
//
// LocalFunctionDeclaration (not FunctionDeclaration) here for the same reason, but with a
// narrower fix: a local function's `functionBody` is *never* optional in valid Kotlin (a
// body-less function header is only legal for interface/abstract/external members, never as a
// statement), so requiring it — instead of trying to force `!greedy` through the same
// unreachable `statement+` wall — removes the ambiguous "reduce without a body" path outright.
// LocalPropertyDeclaration (not PropertyDeclaration) here for real grammatical reasons, not just
// conflict workarounds: Kotlin doesn't allow `get`/`set` accessors on local variables at all (only
// top-level/member properties can have them), and local variables can't declare type parameters
// or constraints either (locals are never generic) — so this variant omits `PropertyAccessor*`,
// `TypeParameters?`, and `TypeConstraints?` entirely. Beyond matching real Kotlin, dropping
// TypeConstraints specifically was what it took to unblock the build: every remaining "=" vs.
// AssignmentStatement shift/reduce conflict in this grammar had `TypeConstraints?` sitting
// immediately before the ambiguous token, and no amount of `!greedy` placement around it made a
// difference — removing the piece (once confirmed grammatically unnecessary here) succeeded
// where marking it kept failing.
declarationStatement {
  LocalPropertyDeclaration | LocalFunctionDeclaration | LocalClassDeclaration | ObjectDeclaration | TypeAlias
}

// `val (a, b) = pair`, `for ((k, v) in map)` — each entry may carry its own type.
DestructuringDeclaration {
  "(" commaSep1<destructuringEntry> ")"
}

destructuringEntry {
  Definition (":" type)?
}

LocalPropertyDeclaration {
  modifier* (kw<"val"> | kw<"var">) (Definition | DestructuringDeclaration)
    (":" type)?
    (!greedy "=" expression | !greedy ckw<"by"> expression)?
}

// A local class needs its body: without it, "the header is complete" and "the next statement starts"
// compete for the same token, which no precedence marker can reach (see the note above).
LocalClassDeclaration {
  modifier* (kw<"class"> | kw<"interface">) Definition TypeParameters? classTail ClassBody
}

LocalFunctionDeclaration {
  modifier* kw<"fun"> TypeParameters? Definition
    "(" commaSep<FunctionParameter> ")" (":" type)? (!greedy TypeConstraints)? functionBody
}

// Statements in a brace body are separated by `Nl`, an external token (tokens.js `nlTokens`) for a
// line break or `;` — not by plain whitespace. Kotlin has no ASI *grammar*, but a newline does end a
// statement unless the next token continues the expression (`.`, `?.`, `?:`, `&&`, `||`, `as`,
// `else`, `catch`, `finally`), and without it `Foo.a(1)` / `Bar(2)` on consecutive lines collapsed
// into one `InfixExpression` chain (see PROGRESS.md, "Attempts 1-3"). `Nl` is only ever offered
// where the automaton can shift it (`stack.canShift`), so line breaks inside call arguments and
// parentheses stay insignificant. Class bodies and top-level declarations don't need it: every
// member starts with a keyword or modifier, so they were never ambiguous.
stmts {
  Nl? (statement (Nl statement)* Nl?)?
}

Block {
  "{" stmts "}"
}

// No `Block` alternative here (unlike an earlier version of this grammar): `Block` and a bare
// (no-arrow) `LambdaLiteral` are structurally identical (`"{" statement* "}"`), and `LambdaLiteral`
// is already reachable here via `statement -> ExpressionStatement -> expression`, so offering
// `Block` too is a redundant dual-representation of the same input — hard reduce/reduce, same
// class of conflict as the `IfStatement`/`IfExpression` dedup below. A `{ ... }` control-flow body
// is accordingly tagged `LambdaLiteral`, not `Block`, in the parsed tree (`Block` remains its own
// distinct, unambiguous node everywhere it's used unconditionally: function bodies, init blocks,
// try/catch/finally, secondary constructors). See docs/adr-021-kotlin-parsing.md.
controlBody {
  statement
}

ExpressionStatement {
  expression
}

ForStatement {
  kw<"for"> "(" modifier* (Definition | DestructuringDeclaration) (":" type)? kw<"in"> expression ")" controlBody
}

WhileStatement {
  kw<"while"> "(" expression ")" controlBody
}

DoWhileStatement {
  kw<"do"> controlBody kw<"while"> "(" expression ")"
}

// No `@label` support (non-local `return@foo`/`break@foo`/`continue@foo`): without
// newline-sensitivity (this grammar treats newlines as plain whitespace — see the `;` @skip
// note below), a bare `return`/`break`/`continue` immediately followed by `@` is ambiguous
// between "this statement's own label" and "an annotation starting the *next* statement", the
// same dangling-optional-suffix-vs-next-sibling shape as PrimaryConstructor/ClassBody above, and
// unlike those it kept resisting a `!greedy` resolution here (deep interaction with
// CallableReference). Labeled non-local jumps (common inside lambdas passed to `forEach` etc.)
// are a real Phase 0b gap — see docs/adr-021-kotlin-parsing.md.
ReturnStatement {
  kw<"return"> (LabelAt Identifier)? (!greedy expression)?
}

BreakStatement {
  kw<"break"> (LabelAt Identifier)?
}

ContinueStatement {
  kw<"continue"> (LabelAt Identifier)?
}

ThrowStatement {
  kw<"throw"> expression
}

expression[@isGroup=Expression] {
  BinaryExpression |
  RangeExpression |
  InfixExpression |
  IsExpression |
  AsExpression |
  PrefixExpression |
  LabeledLambda |
  LambdaLiteral |
  baseExpression
}

BinaryExpression {
  expression !equality op<Equality, "==" | "!=" | "===" | "!=="> expression |
  expression !compare op<Compare, "<" | ">" | "<=" | ">="> expression |
  expression !and op<Logic, "&&"> expression |
  expression !or op<Logic, "||"> expression |
  expression !elvis Elvis (expression | jumpStatement) |
  expression !plus op<Arith, "+" | "-"> expression |
  expression !times op<Arith, "*" | "/" | "%"> expression
}

RangeExpression {
  expression !range (".." | "..<") expression
}

InfixExpression {
  expression !infixFn Identifier expression
}

IsExpression {
  expression !namedCheck (kw<"is"> | NotIs) type
}

AsExpression {
  expression !asCast kw<"as"> "?"? type
}

PrefixExpression {
  (op<Arith, "-" | "+"> | op<Logic, "!"> | op<Update, "--" | "++">) !prefix expression
}

baseExpression {
  literal |
  StringTemplate |
  ThisExpression |
  SuperExpression |
  Identifier |
  ParenthesizedExpression |
  IfExpression |
  WhenExpression |
  TryExpression |
  ObjectLiteral |
  AnonymousFunction |
  CollectionLiteral |
  CallableReference |
  NavigationExpression |
  CallExpression |
  IndexingExpression |
  PostfixUnaryExpression
}

// `this@Outer`, `super<Base>.f()`, `super@Outer.f()`.
ThisExpression {
  kw<"this"> (LabelAt Identifier)?
}

SuperExpression {
  kw<"super"> (!typeArgs "<" type ">")? (LabelAt Identifier)?
}

// `callback@{ ... }` / `fold@ { ... }` — a labeled lambda used as an expression or argument.
LabeledLambda {
  LabelDef LambdaLiteral
}

ParenthesizedExpression {
  "(" expression ")"
}

IfExpression {
  kw<"if"> "(" expression ")" controlBody (!else kw<"else"> controlBody)?
}

WhenExpression {
  kw<"when"> ("(" WhenSubject ")")? "{" whenEntries "}"
}

// Brace-less branches (`A -> readA(1)` newline `B -> readB(2)`) need the same `Nl` separator as a
// statement list: `controlBody` is a single statement, so without it the next entry's leading
// condition was swallowed as an infix operand of the previous branch's body.
whenEntries {
  Nl? (WhenEntry (Nl? WhenEntry)* Nl?)?
}

WhenEntry {
  (whenConditions WhenGuard? | kw<"else">) "->" controlBody
}

whenConditions {
  whenCondition (!greedy "," whenCondition)* (!greedy ",")?
}

// `when (val x = f()) { ... }` — the subject may bind a variable.
WhenSubject {
  (kw<"val"> Definition (":" type)? "=")? expression
}

// `is String if x.isEmpty() -> ...` — a guard on a when branch.
WhenGuard {
  kw<"if"> expression
}

whenCondition {
  (kw<"in"> | NotIn) expression |
  (kw<"is"> | NotIs) type |
  expression
}

TryExpression {
  kw<"try"> Block CatchClause* FinallyClause?
}

CatchClause {
  !else kw<"catch"> "(" modifier* Definition ":" type ")" Block
}

FinallyClause {
  kw<"finally"> Block
}

// `[1, 2]` — an array literal (only valid in annotation arguments).
CollectionLiteral {
  "[" commaSep<expression> "]"
}

// `fun(x: Int): Int { ... }` — an anonymous function expression.
AnonymousFunction {
  kw<"fun"> "(" commaSep<FunctionParameter> ")" (":" type)? functionBody
}

ObjectLiteral {
  kw<"object"> (":" DelegationSpecifiers)? ClassBody
}

// Bare/simple form only (`Foo::bar`, `::bar`) — not `pkg.Foo::bar` or `List<T>::bar`. Using
// `simpleType?` here (instead of `Identifier`) would make TypeName and baseExpression's own
// `Identifier` alt reduce-reduce-ambiguous on every bare identifier, since both would then be
// reachable from the same baseExpression start position (see docs/adr-021-kotlin-parsing.md).
// Qualified/generic callable references are a Phase 0b addition.
CallableReference {
  baseExpression !postfix TypeArguments? "::" (Identifier | kw<"class">) |
  "::" (Identifier | kw<"class">)
}

NavigationExpression {
  baseExpression !postfix (op<Nav, "."> | SafeNav) (Identifier | kw<"class">)
}

CallExpression {
  baseExpression !postfix (TypeArguments? ArgumentList (!postfix TrailingLambda)? | TypeArguments? TrailingLambda)
}

// `listOf<Int>(1)`, `HashMap<String, Int>()`, `foo<T> { }`. The `<` is its own token (see tokens.js)
// because it is indistinguishable from a comparison until the matching `>` and what follows it.
TypeArguments {
  TypeArgsOpen commaSep1<typeArg> ">"
}

// `@Foo<Bar>` — same node as a call's type arguments; its own open token (see tokens.js) because
// no `(`/`{`/`::` follows the closing `>`.
AnnotationTypeArguments[@name=TypeArguments] {
  AnnotationTypeArgsOpen commaSep1<typeArg> ">"
}

ArgumentList {
  "(" commaSep<callArgument> ")"
}

callArgument {
  (Identifier "=")? "*"? expression
}

TrailingLambda {
  LabelDef? LambdaLiteral
}

LambdaLiteral {
  "{" (lambdaParameters "->")? stmts "}"
}

lambdaParameters {
  commaSep1<lambdaParameter>
}

// `@Foo` on a lambda parameter — `ParamAt` (tokens.js) is only emitted when a parameter name follows
// the annotation, which keeps it apart from an annotated declaration at the start of the body.
LambdaParamAnnotation {
  ParamAt (useSiteTarget ":")? dottedName (!greedy ArgumentList)?
}

lambdaParameter {
  LambdaParamAnnotation* (Definition | LambdaDestructuring) (":" type)?
}

// `{ (a, b) -> ... }`. The `(` is its own token (see tokens.js) because a lambda body may also start
// with a parenthesized expression, and the two only differ after the closing paren.
LambdaDestructuring[@name=DestructuringDeclaration] {
  DestructureOpen commaSep1<destructuringEntry> ")"
}

IndexingExpression {
  baseExpression !postfix "[" commaSep1<expression> "]"
}

PostfixUnaryExpression {
  baseExpression !postfix (NotNull | op<Update, "--" | "++">)
}

literal {
  IntegerLiteral |
  FloatingPointLiteral |
  @specialize[@name=BooleanLiteral]<identifier, "true" | "false"> |
  CharacterLiteral |
  kw<"null">
}

// Function types, parenthesized types and nullable function types (`(() -> Unit)?`) all start with
// the same `(`, and an LR(1) parser can't defer the choice past a shared prefix — a separate
// `"(" type ")"` rule conflicts with FunctionType's own `"(" commaSep<type> ")"` at the closing
// paren. So there is ONE production: the parenthesized list, then an optional `-> type`. No arrow
// means it was a parenthesized type (`(Foo)`, `(suspend () -> T)`), which is why `NullableType` and
// `ParenReceiver` accept a `FunctionType`. `!greedy` on the arrow makes `{ x: (Int) -> Int -> x }`
// read `(Int) -> Int` as the parameter's function type, as Kotlin does.
type {
  FunctionType |
  NullableType |
  simpleType |
  DefinitelyNonNullType |
  AnnotatedType
}

// `T & Any`.
DefinitelyNonNullType {
  simpleType !greedy "&" simpleType
}

// `x: @Foo String`, `class A : @Foo I`.
AnnotatedType {
  annotationUse type
}

// `!greedy` on the `?`: `() -> Unit?` is a function returning `Unit?`, not a nullable function
// (that needs parens, `(() -> Unit)?`), so the `?` attaches to the return type.
NullableType {
  (simpleType | FunctionType) !greedy "?"
}

// Function-type parameters may be named (`(timeout: Int) -> Unit`).
functionParam {
  (Identifier ":")? type
}

// `suspend` and an optional receiver are both prefixes of the same production: `suspend
// Foo.(Int) -> Unit`. The receiver starts from `TypeName | ScopedTypeName | GenericType` directly,
// NOT from `simpleType`: reducing to `simpleType` first forces a reduce before the `.`, which
// conflicts with ScopedTypeName's own shift of that same `.` (the "spurious conflict" an earlier
// version of this grammar hit). Starting from the same nonterminals lets both shift the `.`, and
// the next token — `(` versus an identifier — picks FunctionType or ScopedTypeName.
FunctionType {
  ckw<"suspend">? ((TypeName | ScopedTypeName | GenericType) ".")?
    "(" commaSep<functionParam> ")" (!greedy "->" type)?
}

// A parenthesized receiver on an extension declaration: `fun (suspend () -> T).run()`. After `fun`
// (and optional type parameters) a `(` can only start this, so it needs no lookahead.
ParenReceiver {
  "(" type ")"
}

// One dotted segment of an extension receiver, with optional type arguments (`List<T>`).
ReceiverSegment {
  Identifier (!typeArgs "<" commaSep1<typeArg> ">")?
}

simpleType {
  TypeName |
  ScopedTypeName |
  GenericType
}

TypeName {
  Identifier
}

ScopedTypeName {
  (TypeName | ScopedTypeName | GenericType) !scope "." TypeName
}

GenericType[@dynamicPrecedence=1] {
  (TypeName | ScopedTypeName) !typeArgs "<" commaSep1<typeArg> ">"
}

Definition {
  identifier | backtickIdentifier
}

Identifier {
  identifier | backtickIdentifier
}

kw<term> { @specialize[@name={term}]<identifier, term> }

ckw<term> { @extend[@name={term}]<identifier, term> }

op<tag, expr> { expr }

// Both accept a trailing comma (`foo(a, b,)`, valid since Kotlin 1.4 and the norm in ktlint-formatted
// code with one argument per line).
commaSep<expr> { (expr ("," expr)* ","?)? }

commaSep1<expr> { expr ("," expr)* ","? }

@skip {} {
  StringTemplate {
    StringStart (stringContent | Escape | Interpolation | SimpleInterpolation)* stringEnd |
    StringStartTriple (stringContent | Escape | Interpolation | SimpleInterpolation)* stringEndTriple
  }
}

Interpolation {
  interpolationStart expression "}"
}

@skip { LineComment | BlockComment | whitespace | ";" }

// Declared before `@tokens` so it is tried ahead of the built-in whitespace skip: it has to claim
// a line break before `whitespace` swallows it.
// Block comments nest in Kotlin (`/* a /* b */ c */`), which a regular token can't express.
@external tokens commentTokens from "./tokens.js" { BlockComment }

@external tokens nlTokens from "./tokens.js" { Nl, AccessorNl }

// An `@` glued to the preceding identifier/keyword (`return@f`, `this@A`, `outer@ for`) is a label
// marker; an annotation's `@` never directly follows an identifier character. Telling them apart in
// the tokenizer avoids an unresolvable conflict with the next declaration's leading annotation.
@external tokens labelTokens from "./tokens.js" { LabelAt, LabelDef, DestructureOpen, TypeArgsOpen, AnnotationTypeArgsOpen, EntryAt, ParamAt }

@tokens {
  whitespace {
    @whitespace+
  }

  digits {
    $[0-9]+ ("_"+ $[0-9]+)*
  }

  hexDigits {
    $[A-Fa-f0-9]+ ("_" $[A-Fa-f0-9]+)*
  }

  IntegerLiteral {
    (digits |
     ("0x" | "0X") hexDigits |
     ("0b" | "0B") $[01]+ ("_" $[01]+)*)
    ("u" | "U")? ("l" | "L")?
  }

  exponent {
    $[eE] ("-" | "+")? digits
  }

  floatSuffix {
    $[fF]
  }

  // The dot-form requires a digit *after* the "." (unlike an earlier version of this rule): a
  // bare trailing dot (`digits "." digits?` with the digits optional) isn't valid Kotlin anyway
  // (`1.` alone isn't a legal float literal — Kotlin requires `1.0`), and making it optional
  // meant `1..10` (a range) tokenized as `1.` (greedy maximal-munch FloatingPointLiteral) + `.10`
  // instead of `1` + `..` + `10` — a real, silent mis-tokenization caught by testing against
  // real/synthetic .kt files, not by the generator. See docs/adr-021-kotlin-parsing.md.
  FloatingPointLiteral {
    digits ("." digits exponent? floatSuffix? | exponent floatSuffix? | floatSuffix) |
    "." digits exponent? floatSuffix?
  }

  @precedence { FloatingPointLiteral, IntegerLiteral }

  CharacterLiteral[isolate] {
    "'" (![\\'\n] | "\\u" $[0-9A-Fa-f]+ | "\\" ![\n]) "'"
  }

  StringStartTriple { '"""' }
  StringStart { '"' }

  @precedence { StringStartTriple, StringStart }

  Asterisk { "*" }

  identifierChar { @asciiLetter | @digit | "_" }

  identifier { $[a-zA-Z_] identifierChar* }

  backtickIdentifier { "`" ![`\n]+ "`" }

  @precedence { whitespace, identifier }

  AssignOp {
    ("+" | "-" | "*" | "/" | "%") "="
  }

  Elvis { "?:" }
  SafeNav { "?." }
  NotNull { "!!" }
  NotIs { "!is" }
  NotIn { "!in" }

  Shebang[isolate] {
    "#!" ![\n]*
  }

  LineComment[isolate] {
    "//" ![\n]*
  }

  @precedence { LineComment, Asterisk }
  @precedence { LineComment, "/" }
  @precedence { FloatingPointLiteral, "." }
  @precedence { Elvis, "?" }
  @precedence { SafeNav, "." }
  @precedence { NotNull, "!" }
  @precedence { NotIs, "!" }
  @precedence { NotIn, "!" }
  @precedence { "..<", ".." }
}

@external tokens stringTokens from "./tokens.js" { stringContent, Escape, interpolationStart, SimpleInterpolation, stringEnd, stringEndTriple }

@context trackStrings from "./tokens.js"

@detectDelim
